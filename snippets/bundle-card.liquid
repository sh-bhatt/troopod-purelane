{%- comment -%}
  Accepts:
  - block: {Object} Shopify block object containing combo_card settings
{%- endcomment -%}

{%- assign is_hero = false -%}
{%- if block.settings.badge == 'Best Value' -%}
  {%- assign is_hero = true -%}
{%- endif -%}

<!-- STRICT MATH FIX: Calculate original price in cents -->
{%- assign original_total_price = 0 -%}
{%- for prod in block.settings.products -%}
  {%- assign prod_price = prod.compare_at_price | default: prod.price -%}
  {%- assign original_total_price = original_total_price | plus: prod_price -%}
{%- endfor -%}

<!-- Convert merchant input (e.g., 499) to strict cents (49900) -->
{%- assign bundle_price_cents = block.settings.bundle_price | times: 100 -%}

{%- assign saved_amount = 0 -%}
{%- if original_total_price > bundle_price_cents and bundle_price_cents > 0 -%}
  {%- assign saved_amount = original_total_price | minus: bundle_price_cents -%}
{%- endif -%}

<article class="glass combo {% if is_hero %}hero-combo{% endif %}">
  <div class="tray">
    {%- if saved_amount > 0 -%}
      <span class="save">You save {{ saved_amount | money_without_trailing_zeros }}</span>
    {%- elsif is_hero -%}
      <span class="save">Biggest saving</span>
    {%- endif -%}

    {%- if block.settings.badge != blank -%}
      <span class="flag">{{ block.settings.badge | escape }}</span>
    {%- endif -%}

    <div class="stack">
      {%- if block.settings.products.size > 0 -%}
        <!-- LAYOUT FIX: Limit to 3 bottles max to protect flexbox -->
        {%- for prod in block.settings.products limit: 3 -%}
          <span class="it">
            {%- if prod.featured_image -%}
              <img src="{{ prod.featured_image | image_url: width: 120 }}" 
                   alt="{{ prod.featured_image.alt | default: prod.title | escape }}" 
                   style="height: 66px; width: auto; max-width: 100%; margin: 0 auto 8px; filter: drop-shadow(0 8px 13px rgba(1,24,22,.5)); object-fit: contain; display: block;" 
                   loading="lazy" decoding="async">
            {%- else -%}
              <div class="tile" style="height: 66px; width: 44px; margin: 0 auto 8px; display: grid; place-items: center; border-radius: 9px; background: rgba(236,230,247,.08); border: 1px dashed rgba(236,230,247,.26); color: var(--accent);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
              </div>
            {%- endif -%}
            
            {%- if prod.featured_image.alt != blank and prod.featured_image.alt != prod.title -%}
              <span>{{ prod.featured_image.alt | escape }}</span>
            {%- else -%}
              <span>{{ prod.title | escape }}</span>
            {%- endif -%}
          </span>
          {%- unless forloop.last -%}
            <span class="plus" aria-hidden="true">+</span>
          {%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        <span class="it">
          <div class="tile" style="height: 66px; width: 44px; margin: 0 auto 8px; display: grid; place-items: center; border-radius: 9px; background: rgba(236,230,247,.08); border: 1px dashed rgba(236,230,247,.26); color: var(--accent);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          </div>
          <span>No items</span>
        </span>
      {%- endif -%}
    </div>
  </div>

  <div class="body">
    <h3 title="{{ block.settings.title | escape }}">{{ block.settings.title | escape }}</h3>
    
    <div class="cnt">{{ block.settings.products.count | default: block.settings.products.size }} products</div>
    
    <p class="inc">{{ block.settings.description | escape }}</p>
    
    <div class="prow">
      <strong>{{ bundle_price_cents | money_without_trailing_zeros }}</strong>
      {%- if original_total_price > bundle_price_cents -%}
        <s>{{ original_total_price | money_without_trailing_zeros }}</s>
        {%- if saved_amount > 0 -%}
          <em>Save {{ saved_amount | money_without_trailing_zeros }}</em>
        {%- endif -%}
      {%- endif -%}
    </div>
    
    <div class="fine">Inclusive of all taxes &middot; COD available</div>
    
    <button type="button" class="btn {% if is_hero %}btn-primary{% else %}btn-ghost{% endif %}" style="width: 100%; justify-content: center;">
      Shop bundle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px;margin-left:8px;"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
    </button>
  </div>
</article>