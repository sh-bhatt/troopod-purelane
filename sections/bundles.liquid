<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <!-- PERFORMANCE FIX: Removed 'rv' scroll-reveal class to prevent layout thrashing -->
    <div class="glass sec-pad" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="lede" style="margin:0 auto">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="tiers">
      {%- for block in section.blocks -%}
        <article class="glass tier {% if block.settings.is_best_seller %}best{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.tag != blank -%}
            <span class="tag">{{ block.settings.tag | escape }}</span>
          {%- endif -%}

          <!-- AUTOMATED TIER GRAPHICS: Renders exact bottle illustration stacks based on position -->
          <div class="tierpix {% if forloop.index == 3 %}five{% endif %}" aria-hidden="true">
            {%- if forloop.index == 1 -%}
              <span class="pimg p-combo2" role="img" aria-label="Purelane tap cleaner and kitchen cleaner combo pack"></span>
            {%- elsif forloop.index == 2 -%}
              <span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span>
              <span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span>
              <span class="pimg p-dish" role="img" aria-label="Purelane organic dishwash liquid gel"></span>
            {%- elsif forloop.index == 3 -%}
              <span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span>
              <span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span>
              <span class="pimg p-floor" role="img" aria-label="Purelane natural herbal floor cleaner"></span>
              <span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner"></span>
              <span class="pimg p-laundry" role="img" aria-label="Purelane non-toxic laundry detergent"></span>
            {%- endif -%}
          </div>

          <div class="qty">
            {{ block.settings.product_count }}<small>Products</small>
          </div>

          <div class="price">
            ₹{{ block.settings.price }}
            {%- if block.settings.compare_at_price > block.settings.price -%}
              <s>₹{{ block.settings.compare_at_price }}</s>
            {%- endif -%}
          </div>

          {%- if block.settings.per_product_text != blank -%}
            <p class="body-s" style="font-size:12px">{{ block.settings.per_product_text | escape }}</p>
          {%- endif -%}

          {%- if block.settings.feature_1 != blank or block.settings.feature_2 != blank or block.settings.feature_3 != blank -%}
            <ul>
              {%- if block.settings.feature_1 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                  {{ block.settings.feature_1 | escape }}
                </li>
              {%- endif -%}
              {%- if block.settings.feature_2 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                  {{ block.settings.feature_2 | escape }}
                </li>
              {%- endif -%}
              {%- if block.settings.feature_3 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                  {{ block.settings.feature_3 | escape }}
                </li>
              {%- endif -%}
            </ul>
          {%- endif -%}

          {%- assign btn_url = block.settings.button_link | default: '#shop' -%}
          <a class="btn {% if block.settings.is_best_seller %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ btn_url }}">
            {{ block.settings.button_label | escape }}
            {%- if block.settings.is_best_seller -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            {%- endif -%}
          </a>
        </article>
      {%- else -%}
        <p style="text-align: center; width: 100%; color: var(--surface); padding: 20px 0;">Add bundle tier blocks in the Theme Editor</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "class": "section-bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (Small Text)",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle Tier",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Starter"
        },
        {
          "type": "checkbox",
          "id": "is_best_seller",
          "label": "Highlight as Best Seller",
          "default": false
        },
        {
          "type": "number",
          "id": "product_count",
          "label": "Product Count",
          "default": 2
        },
        {
          "type": "number",
          "id": "price",
          "label": "Price (₹)",
          "default": 349
        },
        {
          "type": "number",
          "id": "compare_at_price",
          "label": "Compare at Price (₹)",
          "default": 598
        },
        {
          "type": "text",
          "id": "per_product_text",
          "label": "Per Product Subtext",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag": "Starter",
            "is_best_seller": false,
            "product_count": 2,
            "price": 349,
            "compare_at_price": 598,
            "per_product_text": "Flat ₹174 per product",
            "button_label": "Build this box",
            "feature_1": "Pick any two products",
            "feature_2": "Free shipping across India",
            "feature_3": ""
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Most popular",
            "is_best_seller": true,
            "product_count": 3,
            "price": 499,
            "compare_at_price": 897,
            "per_product_text": "Flat ₹166 per product",
            "button_label": "Build this box",
            "feature_1": "Pick any three products",
            "feature_2": "Covers kitchen and laundry",
            "feature_3": "Free shipping across India"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Whole home",
            "is_best_seller": false,
            "product_count": 5,
            "price": 799,
            "compare_at_price": 1495,
            "per_product_text": "Flat ₹160 per product",
            "button_label": "Build this box",
            "feature_1": "Pick any five products",
            "feature_2": "Every room in one order",
            "feature_3": "Free shipping across India"
          }
        }
      ]
    }
  ]
}
{% endschema %}