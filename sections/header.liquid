{%- comment -%}
  Header Section
  Features: Dynamic menus, live cart count, GPU-accelerated sticky state.
{%- endcomment -%}

<header id="hdr" class="{% if section.settings.enable_sticky %}sticky-header{% endif %}">
  <div class="navpill glass">
    <!-- Brand / Logo -->
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      <span class="mark">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 80 | image_tag: class: 'custom-logo', loading: 'eager', fetchpriority: 'high' }}
        {%- else -%}
          <!-- Default purelane SVG fallback -->
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--accent)">
            <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
            <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
          </svg>
        {%- endif -%}
      </span>
      <span class="txt">
        <span class="n1">{{ section.settings.brand_name | default: shop.name }}</span>
        <span class="n2">{{ section.settings.brand_tagline | default: 'Clean, simply' }}</span>
      </span>
    </a>

    <!-- Main Navigation -->
    <nav class="nav" aria-label="Main">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <!-- Navigation Tools -->
    <div class="navtools">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="ico hide-s" aria-label="Account">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/></svg>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="ico" aria-label="Cart, {{ cart.item_count }} items" id="cart-icon-bubble">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/><circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/></svg>
        {%- if cart.item_count > 0 -%}
          <span class="dot">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>

      <!-- Mobile Menu Trigger -->
      <button class="ico burger" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Purelane"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "Clean, simply"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable Sticky Header",
      "default": true
    }
  ]
}
{% endschema %}