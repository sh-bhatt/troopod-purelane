<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <!-- Removed 'rv' class from panel-head -->
    <div class="panel-head">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>
    
    <div class="shelf">
      {%- assign collection = section.settings.collection -%}
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <!-- Passed an empty string to prevent the snippet from rendering reveal classes -->
          {%- assign anim_class = '' -%}
          
          {%- render 'product-card', product: product, class: anim_class -%}
        {%- endfor -%}
      {%- else -%}
        <p style="text-align: center; width: 100%; color: var(--surface);">Select a collection in the Theme Editor</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Troopod Shop Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (Small Text)",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to Display"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Maximum products to show",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Troopod Shop Grid"
    }
  ]
}
{% endschema %}