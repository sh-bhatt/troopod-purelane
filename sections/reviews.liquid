<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <!-- PERFORMANCE FIX: Removed 'rv' scroll-reveal class to prevent layout thrashing -->
    <div class="revhead">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.rating_text != blank -%}
        <span class="agg"><span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> {{ section.settings.rating_text }}</span>
      {%- endif -%}
      {%- if section.settings.homes_text != blank -%}
        <span class="agg">{{ section.settings.homes_text }}</span>
      {%- endif -%}
    </div>
  </div>
  <!-- PERFORMANCE FIX: Removed 'rv' scroll-reveal class to prevent layout thrashing -->
  <div class="revrail" aria-label="Customer reviews">
    <div class="revtrack">
      {%- comment -%} Infinite marquee loop: loop twice for smooth CSS keyframe transition {%- endcomment -%}
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <article class="glass-2 rcard" {{ block.shopify_attributes }}>
            <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            {%- if block.settings.title != blank -%}
              <h5>{{ block.settings.title | escape }}</h5>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p>{{ block.settings.body | escape }}</p>
            {%- endif -%}
            <div class="who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              {%- if block.settings.author != blank -%}
                <b>{{ block.settings.author | escape }}</b>
              {%- endif -%}
              {%- if block.settings.product_tag != blank -%}
                <span>&middot; {{ block.settings.product_tag | escape }}</span>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Reviews Rail",
  "tag": "section",
  "class": "section-reviews",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (Small Text)",
      "default": "That's what they said"
    },
    {
      "type": "html",
      "id": "rating_text",
      "label": "Rating Aggregator Text",
      "default": "<b>4.8</b> from 8,000+ reviews"
    },
    {
      "type": "html",
      "id": "homes_text",
      "label": "Homes Count Text",
      "default": "Loved by <b>12 lakh+</b> homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review Headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review Content",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Product Tag / Subtitle",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews Rail",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Works like a charm",
            "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "author": "Anita",
