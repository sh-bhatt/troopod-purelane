<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      {%- if section.settings.description != blank -%}
        <p class="lede" style="margin:14px auto 0">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    <div class="comborail">
      {%- for block in section.blocks -%}
        {%- render 'bundle-card', block: block -%}
      {%- else -%}
        <p style="text-align: center; width: 100%; color: var(--surface); padding: 20px 0;">Add combo card blocks in the Theme Editor</p>
      {%- endfor -%}
    </div>

    {%- if section.settings.swipe_cue != blank -%}
      <div class="swipecue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        {{ section.settings.swipe_cue | escape }}
      </div>
    {%- endif -%}

    {%- if section.settings.rail_note != blank -%}
      <p class="railnote">{{ section.settings.rail_note | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Best-Selling Combos",
  "tag": "section",
  "class": "section-combos",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (Small Text)",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "text",
      "id": "swipe_cue",
      "label": "Swipe Cue Text",
      "default": "Swipe for more combos"
    },
    {
      "type": "textarea",
      "id": "rail_note",
      "label": "Rail Note",
      "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay."
    }
  ],
  "blocks": [
    {
      "type": "combo_card",
      "name": "Combo Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen essentials"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner. Everything for a sparkling kitchen, no need to pick separately."
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products"
        },
        {
          "type": "number",
          "id": "bundle_price",
          "label": "Bundle Price",
          "default": 499
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (e.g. Most Popular, Best Value)",
          "default": "Most Popular"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best-Selling Combos",
      "blocks": [
        {
          "type": "combo_card",
          "settings": {
            "title": "Kitchen essentials",
            "description": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner. Everything for a sparkling kitchen, no need to pick separately.",
            "bundle_price": 499,
            "badge": "Most Popular"
          }
        },
        {
          "type": "combo_card",
          "settings": {
            "title": "Laundry care bundle",
            "description": "Includes: Laundry Detergent, Fabric Conditioner & Machine Cleaner Powder. Softer, fresher wash, all in one box.",
            "bundle_price": 499
          }
        },
        {
          "type": "combo_card",
          "settings": {
            "title": "Complete home bundle",
            "description": "Includes: Kitchen Cleaner, Laundry Detergent, Floor Cleaner, Toilet Cleaner & Handwash. Our biggest saving box.",
            "bundle_price": 799,
            "badge": "Best Value"
          }
        }
      ]
    }
  ]
}
{% endschema %}