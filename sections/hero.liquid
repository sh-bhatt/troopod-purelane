
<section class="hero" data-scene="1">
  <div class="hero-grid">

    <!-- BADGE RAIL (Dynamic Blocks) -->
    <div class="badges glass-2" aria-label="Product promises">
      {%- for block in section.blocks -%}
        <div class="badge" {{ block.shopify_attributes }}>
          <span class="bi">
            {%- if block.settings.custom_icon != blank -%}
              {{ block.settings.custom_icon | image_url: width: 40 | image_tag: loading: 'lazy' }}
            {%- else -%}
              {%- case block.settings.builtin_icon -%}
                {%- when 'plant' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                {%- when 'prohibited' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
              {%- endcase -%}
            {%- endif -%}
          </span>
          <span>{{ block.settings.title }}</span>
        </div>
      {%- endfor -%}
    </div>

    <!-- HERO TEXT -->
    <div class="hero-copy">
      <h1 class="d1  in">{{ section.settings.heading }}</h1>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede">{{ section.settings.description | escape }}</p>
      
      <div class="hero-cta">
        <a class="btn btn-primary" href="{{ section.settings.btn_link_1 }}">
          {{ section.settings.btn_label_1 | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        </a>
        <a class="btn btn-ghost" href="{{ section.settings.btn_link_2 }}">{{ section.settings.btn_label_2 | escape }}</a>
      </div>

      <!-- MOBILE BADGES (Dynamic Blocks) -->
      <div class="badgestrip rv rv-d4">
        {%- for block in section.blocks limit: 3 -%}
          <div class="glass-2">
            {%- if block.settings.custom_icon != blank -%}
              {{ block.settings.custom_icon | image_url: width: 32 | image_tag: loading: 'lazy', style: 'width: 18px; height: 18px; margin: 0 auto 6px;' }}
            {%- else -%}
              {%- case block.settings.builtin_icon -%}
                {%- when 'plant' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                {%- when 'prohibited' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
              {%- endcase -%}
            {%- endif -%}
            {{ block.settings.title | strip_html | truncatewords: 3, "" }}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- PRODUCT STAGE (Real Shopify Data) -->
    <div class="hero-prod" id="heroProd">
      <div class="hstage" id="hstage">
        {%- assign p1 = section.settings.hero_product_1 -%}
        {%- assign p2 = section.settings.hero_product_2 -%}
        {%- assign p3 = section.settings.hero_product_3 -%}

        <!-- Slide 1 (Single) -->
        <div class="hslide hs1 on" data-n="1">
          <span class="hp p-kbtl a d1" role="img" aria-label="Kitchen cleaner"></span>
          <div class="glass-2 ptag">
            <span class="lbl">Single bottle</span>
            <span class="val">
              {%- if p1 != blank -%}
                <strong>{{ p1.price | money_without_trailing_zeros }}</strong>
                {%- if p1.compare_at_price > p1.price -%}
                  <s>{{ p1.compare_at_price | money_without_trailing_zeros }}</s>
                {%- endif -%}
              {%- else -%}
                <strong>₹200</strong><s>₹299</s>
              {%- endif -%}
            </span>
            {%- if p1 != blank and p1.compare_at_price > p1.price -%}
              {%- assign discount = p1.compare_at_price | minus: p1.price | times: 100.0 | divided_by: p1.compare_at_price | round -%}
              <span class="cut">{{ discount }}% off</span>
            {%- else -%}
              <span class="cut">33% off</span>
            {%- endif -%}
          </div>
        </div>

        <!-- Slide 2 (Combo) -->
        <div class="hslide hs2" data-n="2">
          <span class="hp p-tbtl a d1" role="img" aria-label="Tap cleaner"></span>
          <span class="hp p-kbtl b d2" role="img" aria-label="Kitchen cleaner"></span>
          <div class="glass-2 ptag">
            <span class="lbl">Any 2 products</span>
            <span class="val">
              {%- assign bundle_2_price = section.settings.bundle_2_price | times: 100 -%}
              {%- if p1 != blank and p2 != blank -%}
                {%- assign comp_2 = p1.compare_at_price | plus: p2.compare_at_price -%}
                <strong>{{ bundle_2_price | money_without_trailing_zeros }}</strong>
                <s>{{ comp_2 | money_without_trailing_zeros }}</s>
              {%- else -%}
                <strong>₹349</strong><s>₹598</s>
              {%- endif -%}
            </span>
            {%- if p1 != blank and p2 != blank -%}
              <span class="cut">Save {{ comp_2 | minus: bundle_2_price | money_without_trailing_zeros }}</span>
            {%- else -%}
              <span class="cut">Save ₹249</span>
            {%- endif -%}
          </div>
        </div>

        <!-- Slide 3 (Trio) -->
        <div class="hslide hs3" data-n="3">
          <span class="hp p-tbtl a d1" role="img" aria-label="Tap cleaner"></span>
          <span class="hp p-mbtl b d2" role="img" aria-label="Copper & brass cleaner"></span>
          <span class="hp p-kbtl c d3" role="img" aria-label="Kitchen cleaner"></span>
          <div class="glass-2 ptag">
            <span class="lbl">Any 3 products</span>
            <span class="val">
              {%- assign bundle_3_price = section.settings.bundle_3_price | times: 100 -%}
              {%- if p1 != blank and p2 != blank and p3 != blank -%}
                {%- assign comp_3 = p1.compare_at_price | plus: p2.compare_at_price | plus: p3.compare_at_price -%}
                <strong>{{ bundle_3_price | money_without_trailing_zeros }}</strong>
                <s>{{ comp_3 | money_without_trailing_zeros }}</s>
              {%- else -%}
                <strong>₹499</strong><s>₹897</s>
              {%- endif -%}
            </span>
            {%- if p1 != blank and p2 != blank and p3 != blank -%}
              <span class="cut">Save {{ comp_3 | minus: bundle_3_price | money_without_trailing_zeros }}</span>
            {%- else -%}
              <span class="cut">Save ₹398</span>
            {%- endif -%}
          </div>
        </div>
      </div>
      
      <div class="hdots" id="hdots">
        <button type="button" class="on" aria-label="Show 1 product"></button>
        <button type="button" class="" aria-label="Show 2 products"></button>
        <button type="button" class="" aria-label="Show 3 products"></button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Troopod Hero Section",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Clean<br>That<br><span class=\"lime\">Lasts</span>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "btn_label_1",
      "label": "Primary Button Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "btn_link_1",
      "label": "Primary Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "btn_label_2",
      "label": "Secondary Button Label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "btn_link_2",
      "label": "Secondary Button Link",
      "default": "/"
    },
    {
      "type": "header",
      "content": "Hero Stage Products"
    },
    {
      "type": "product",
      "id": "hero_product_1",
      "label": "Product 1 (Center Bottle)"
    },
    {
      "type": "product",
      "id": "hero_product_2",
      "label": "Product 2 (Left Bottle)"
    },
    {
      "type": "product",
      "id": "hero_product_3",
      "label": "Product 3 (Right Bottle)"
    },
    {
      "type": "number",
      "id": "bundle_2_price",
      "label": "2-Item Bundle Price (₹)",
      "default": 349
    },
    {
      "type": "number",
      "id": "bundle_3_price",
      "label": "3-Item Bundle Price (₹)",
      "default": 499
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Feature Badge",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "builtin_icon",
          "label": "Built-in Icon",
          "options": [
            { "value": "plant", "label": "Plant" },
            { "value": "shield", "label": "Shield" },
            { "value": "prohibited", "label": "Zero / Prohibited" }
          ],
          "default": "plant"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image (Overrides built-in)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Badge Text",
          "default": "Plant<br>powered"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Troopod Hero Section",
      "blocks": [
        { "type": "badge", "settings": { "title": "Plant<br>powered", "builtin_icon": "plant" } },
        { "type": "badge", "settings": { "title": "Safe for<br>kids & pets", "builtin_icon": "shield" } },
        { "type": "badge", "settings": { "title": "Zero harsh<br>chemicals", "builtin_icon": "prohibited" } }
      ]
    }
  ]
}
{% endschema %}